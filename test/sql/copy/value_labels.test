# name: test/sql/copy/value_labels.test
# description: ENUM and value label roundtrip in dta format
# group: [copy]

require dta

# ============================================================
# Basic ENUM roundtrip
# ============================================================

statement ok
CREATE TYPE fruit AS ENUM ('apple', 'banana', 'cherry')

statement ok
CREATE TABLE fruit_table (f fruit)

statement ok
INSERT INTO fruit_table VALUES ('apple'), ('banana'), ('cherry'), ('apple')

statement ok
COPY (SELECT * FROM fruit_table) TO '__TEST_DIR__/enum_basic.dta' (FORMAT dta)

# Without value_labels: reads as TINYINT (0-indexed codes)
query I
SELECT typeof(f) FROM read_dta('__TEST_DIR__/enum_basic.dta') LIMIT 1
----
TINYINT

# With value_labels: reads as ENUM
query I
SELECT typeof(f) FROM read_dta('__TEST_DIR__/enum_basic.dta', value_labels=true) LIMIT 1
----
ENUM('apple', 'banana', 'cherry')

query I
SELECT * FROM read_dta('__TEST_DIR__/enum_basic.dta', value_labels=true) ORDER BY f
----
apple
apple
banana
cherry

statement ok
DROP TABLE fruit_table

statement ok
DROP TYPE fruit

# ============================================================
# ENUM with NULL
# ============================================================

statement ok
CREATE TYPE size AS ENUM ('S', 'M', 'L', 'XL')

statement ok
CREATE TABLE size_table (s size)

statement ok
INSERT INTO size_table VALUES ('S'), (NULL), ('L'), ('XL'), (NULL)

statement ok
COPY (SELECT * FROM size_table) TO '__TEST_DIR__/enum_null.dta' (FORMAT dta)

query I
SELECT * FROM read_dta('__TEST_DIR__/enum_null.dta', value_labels=true)
----
S
NULL
L
XL
NULL

query I
SELECT count(*) FROM read_dta('__TEST_DIR__/enum_null.dta', value_labels=true) WHERE s IS NULL
----
2

statement ok
DROP TABLE size_table

statement ok
DROP TYPE size

# ============================================================
# ENUM with many categories (fits in byte: <= 100)
# ============================================================

statement ok
CREATE TYPE letter AS ENUM ('a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j',
    'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z')

statement ok
COPY (SELECT 'a'::letter AS l UNION ALL SELECT 'z'::letter) TO '__TEST_DIR__/enum_26.dta' (FORMAT dta)

query I
SELECT * FROM read_dta('__TEST_DIR__/enum_26.dta', value_labels=true) ORDER BY l
----
a
z

statement ok
DROP TYPE letter

# ============================================================
# ENUM column alongside other types
# ============================================================

statement ok
CREATE TYPE status AS ENUM ('active', 'inactive', 'pending')

statement ok
COPY (
    SELECT 1::INTEGER AS id, 'active'::status AS st, 'Alice' AS name
    UNION ALL
    SELECT 2, 'pending'::status, 'Bob'
    UNION ALL
    SELECT 3, 'inactive'::status, 'Charlie'
) TO '__TEST_DIR__/enum_mixed.dta' (FORMAT dta)

query ITI
SELECT id, name, typeof(st) FROM read_dta('__TEST_DIR__/enum_mixed.dta', value_labels=true) ORDER BY id
----
1	Alice	ENUM('active', 'inactive', 'pending')
2	Bob	ENUM('active', 'inactive', 'pending')
3	Charlie	ENUM('active', 'inactive', 'pending')

query ITT
SELECT id, st, name FROM read_dta('__TEST_DIR__/enum_mixed.dta', value_labels=true) ORDER BY id
----
1	active	Alice
2	pending	Bob
3	inactive	Charlie

statement ok
DROP TYPE status

# ============================================================
# ENUM with more than 100 entries (maps to Stata int; the enum's
# physical storage in DuckDB is still uint8 up to 255 entries)
# ============================================================

statement ok
CREATE TYPE big_enum AS ENUM ('v000', 'v001', 'v002', 'v003', 'v004', 'v005', 'v006', 'v007', 'v008', 'v009', 'v010', 'v011', 'v012', 'v013', 'v014', 'v015', 'v016', 'v017', 'v018', 'v019', 'v020', 'v021', 'v022', 'v023', 'v024', 'v025', 'v026', 'v027', 'v028', 'v029', 'v030', 'v031', 'v032', 'v033', 'v034', 'v035', 'v036', 'v037', 'v038', 'v039', 'v040', 'v041', 'v042', 'v043', 'v044', 'v045', 'v046', 'v047', 'v048', 'v049', 'v050', 'v051', 'v052', 'v053', 'v054', 'v055', 'v056', 'v057', 'v058', 'v059', 'v060', 'v061', 'v062', 'v063', 'v064', 'v065', 'v066', 'v067', 'v068', 'v069', 'v070', 'v071', 'v072', 'v073', 'v074', 'v075', 'v076', 'v077', 'v078', 'v079', 'v080', 'v081', 'v082', 'v083', 'v084', 'v085', 'v086', 'v087', 'v088', 'v089', 'v090', 'v091', 'v092', 'v093', 'v094', 'v095', 'v096', 'v097', 'v098', 'v099', 'v100', 'v101', 'v102', 'v103', 'v104', 'v105', 'v106', 'v107', 'v108', 'v109', 'v110', 'v111', 'v112', 'v113', 'v114', 'v115', 'v116', 'v117', 'v118', 'v119', 'v120', 'v121', 'v122', 'v123', 'v124', 'v125', 'v126', 'v127', 'v128', 'v129', 'v130', 'v131', 'v132', 'v133', 'v134', 'v135', 'v136', 'v137', 'v138', 'v139', 'v140', 'v141', 'v142', 'v143', 'v144', 'v145', 'v146', 'v147', 'v148', 'v149')

statement ok
COPY (
    SELECT 1::INTEGER AS id, 'v000'::big_enum AS e
    UNION ALL
    SELECT 2, 'v042'::big_enum
    UNION ALL
    SELECT 3, 'v149'::big_enum
) TO '__TEST_DIR__/enum_big.dta' (FORMAT dta)

query II
SELECT id, e FROM read_dta('__TEST_DIR__/enum_big.dta', value_labels=true) ORDER BY id
----
1	v000
2	v042
3	v149

statement ok
DROP TYPE big_enum
